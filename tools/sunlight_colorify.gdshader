    vec3(1.000, 0.667, 0.333), // #FFAA55
    vec3(1.000, 0.667, 0.000), // #FFAA00
    vec3(0.000, 1.000, 0.000), // #00FF00
    vec3(0.667, 0.000, 0.333), // #AA0055
    vec3(0.667, 0.000, 0.000), // #AA0000
    vec3(0.000, 0.667, 0.667), // #00AAAA
